        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import numpy as np\n",
        "from matplotlib.offsetbox import AnnotationBbox, OffsetImage\n",
        "\n",
        "# --- 1. DEFINIR LOS DATOS (Solución al NameError) ---\n",
        "\n",
        "# OPCIÓN A: Si tienes un archivo con tus datos, cárgalo aquí (descomenta la línea):\n",
        "# df_pos = pd.read_csv('ruta_a_tu_archivo.csv')\n",
        "\n",
        "# OPCIÓN B: Datos simulados para probar el código (Bórralo cuando uses tus datos reales)\n",
        "np.random.seed(42)\n",
        "df_pos = pd.DataFrame({\n",
        "    'timestamp_ms': np.arange(0, 100000, 1000),\n",
        "    'x': np.random.normal(7500, 2000, 100), # Simula posiciones X en el mapa\n",
        "    'y': np.random.normal(7500, 2000, 100)  # Simula posiciones Y en el mapa\n",
        "})\n",
        "\n",
        "# --- 2. PROCESAMIENTO DE COORDENADAS ---\n",
        "\n",
        "# Asegurarse de que las coordenadas estén dentro de los límites del mapa (0 a 15000)\n",
        "x_coords = np.clip(np.array(df_pos['x']), 0, 15000)\n",
        "y_coords = np.clip(np.array(df_pos['y']), 0, 15000)\n",
        "\n",
        "# Corrección lógica: Ahora usamos x_coords e y_coords (los que ya están limitados)\n",
        "df_eventos_lol = pd.DataFrame({\n",
        "    'timestamp_ms': df_pos['timestamp_ms'],\n",
        "    'x': x_coords,\n",
        "    'y': y_coords\n",
        "})\n",
        "\n",
        "print(\"DataFrame de eventos listo:\")\n",
        "print(df_eventos_lol.head())\n",
        "\n",
        "\n",
        "# --- 3. CARGAR LA IMAGEN DEL MAPA DE LOL ---\n",
        "try:\n",
        "    # ¡IMPORTANTE!: Reemplaza 'summoners_rift_map.png' con tu ruta real.\n",
        "    mapa_lol_img = plt.imread('summoners_rift_map.png')\n",
        "    mapa_cargado = True\n",
        "except FileNotFoundError:\n",
        "    print(\"\\nADVERTENCIA: No se encontró la imagen del mapa.\")\n",
        "    print(\"Se dibujará el mapa de calor con un fondo en blanco.\")\n",
        "    mapa_cargado = False\n",
        "\n",
        "\n",
        "# --- 4. CONFIGURACIÓN DEL GRÁFICO ---\n",
        "fig, ax = plt.subplots(figsize=(10, 10))\n",
        "\n",
        "map_x_min, map_x_max = 0, 15000\n",
        "map_y_min, map_y_max = 0, 15000\n",
        "\n",
        "# Si la imagen existe, la dibuja de fondo\n",
        "if mapa_cargado:\n",
        "    ax.imshow(mapa_lol_img, extent=[map_x_min, map_x_max, map_y_min, map_y_max], aspect='auto')\n",
        "\n",
        "# Dibuja el KDE\n",
        "sns.kdeplot(\n",
        "    x=df_eventos_lol['x'],\n",
        "    y=df_eventos_lol['y'],\n",
        "    ax=ax,\n",
        "    levels=10,\n",
        "    fill=True,\n",
        "    cmap='viridis',\n",
        "    alpha=0.5,\n",
        "    zorder=1,\n",
        "    thresh=0.05\n",
        ")\n",
        "\n",
        "# Configuración de los ejes y título\n",
        "ax.set_xlim(map_x_min, map_x_max)\n",
        "ax.set_ylim(map_y_min, map_y_max)\n",
        "ax.set_title('Mapa de Calor de Eventos en la Grieta del Invocador')\n",
        "ax.set_xlabel('Coordenada X')\n",
        "ax.set_ylabel('Coordenada Y')\n",
        "\n",
        "plt.show()"
