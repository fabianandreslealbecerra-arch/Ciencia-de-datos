        "def analizar_rendimiento_jugador(match_data, puuid):\n",
        "    try:\n",
        "        # Encontramos al jugador\n",
        "        participant = next(p for p in match_data[\"info\"][\"participants\"] if p[\"puuid\"] == puuid)\n",
        "\n",
        "        # El diccionario 'challenges' tiene estadísticas avanzadas pre-calculadas por Riot\n",
        "        challenges = participant.get(\"challenges\", {})\n",
        "\n",
        "        # Calculamos los minutos reales que duró la partida\n",
        "        minutos_jugados = match_data[\"info\"][\"gameDuration\"] / 60\n",
        "\n",
        "        # Calculamos el CS (Súbditos de línea + Monstruos de jungla)\n",
        "        cs_total = participant.get(\"totalMinionsKilled\", 0) + participant.get(\"neutralMinionsKilled\", 0)\n",
        "        cs_por_minuto = cs_total / minutos_jugados if minutos_jugados > 0 else 0\n",
        "\n",
        "        # Armamos nuestro reporte\n",
        "        reporte = {\n",
        "            \"Campeón\": participant.get(\"championName\"),\n",
        "            \"Victoria\": participant.get(\"win\"),\n",
        "            \"KDA\": round(challenges.get(\"kda\", 0), 2),\n",
        "            \"Participación en Kills (%)\": round(challenges.get(\"killParticipation\", 0) * 100, 1),\n",
        "            \"Daño por Minuto (DPM)\": round(challenges.get(\"damagePerMinute\", 0), 1),\n",
        "            \"CS por Minuto\": round(cs_por_minuto, 1),\n",
        "            \"Visión por Minuto\": round(challenges.get(\"visionScorePerMinute\", 0), 2),\n",
        "            \"Pinks Comprados\": participant.get(\"visionWardsBoughtInGame\", 0),\n",
        "            \"Oro por Minuto\": round(challenges.get(\"goldPerMinute\", 0), 1)\n",
        "        }\n",
        "\n",
        "        return reporte\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error analizando datos: {e}\")\n",
        "        return None\n",
