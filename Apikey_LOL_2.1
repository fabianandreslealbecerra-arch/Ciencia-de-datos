        "def extraer_metricas_avanzadas(match_id, puuid):\n",
        "    url = f\"https://americas.api.riotgames.com/lol/match/v5/matches/{match_id}\"\n",
        "    try:\n",
        "        data = requests.get(url, headers=HEADERS, timeout=10).json()\n",
